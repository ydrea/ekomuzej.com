<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ekomuzej - web i mobilne aplikacije</title>
    <script src="//unpkg.com/alpinejs" defer></script>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
        background-color: #f5f5f5;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        overflow: hidden;
      }

      .c {
        margin: 1em;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        width: 100%;
        position: relative;
      }

      .veleb {
        position: absolute;
        top: 40%;
        z-index: 0;
      }

      .veleb img {
        display: block;
        height: 300px;
        width: auto;
      }

      .container {
        position: relative;
        display: grid;
        grid-template-columns: repeat(5, 100px);
        grid-template-rows: repeat(5, 100px);
        z-index: 2;
        width: 500px;
        height: 500px;
        border: 1px solid #ccc;
      }

      .container div {
        aspect-ratio: 1 !important;
      }

      .box {
        background-color: #1e40af;
        color: #fff;
        font-size: 1rem;
        z-index: 2;
        border: solid 5px white;
        padding: 0.1em;
        width: 100px;
        height: 100px;
        transition: all 0.6s ease;
      }

      .box.green {
        background-color: rgb(20, 134, 20);
        padding: 0.3em;
        cursor: pointer;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        line-height: 1.1;
      }

      .box.trans {
        background-color: transparent;
        padding: 0.5rem;
      }

      .title {
        font-family: Arial, sans-serif;
        position: absolute;
        display: flex;
        bottom: 35.9%;
        left: 3.5%;
        font-size: 6.7rem;
        font-weight: 400;
        color: #fff;
        pointer-events: none;
        z-index: 5;
      }

      /* Modal covers the container */
      .modal {
        display: none;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: white;
        z-index: 100;
        border: 1px solid rgb(20, 134, 20);
      }

      .modal.active {
        display: block;
      }

      .modal-content {
        background: white;
        padding: 2rem;
        width: 100%;
        height: 100%;
        overflow-y: auto;
        position: relative;
      }

      .close-modal {
        position: absolute;
        top: 10px;
        right: 15px;
        font-size: 1.5rem;
        cursor: pointer;
        background: none;
        border: none;
        color: #148614;
        z-index: 101;
      }

      /* Overlay covers the rest of the page */
      .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(255, 255, 255, 0.5);
        z-index: 99; /* Below modal but above everything else */
      }
      .modal-overlay.active {
        display: block;
      }

      .pjat {
        color: #148614;
        height: 100%;
        display: flex;
        flex-direction: column;
      }

      .pjat h2 {
        margin-bottom: 1rem;
        font-size: 1.5rem;
      }

      .pjat p,
      .pjat li {
        margin-bottom: 0.8rem;
        line-height: 1.5;
        font-size: 1rem;
      }

      .pjat ul {
        padding-left: 1.5rem;
      }

      .dlogici {
        margin-top: auto;
        text-align: center;
        padding-top: 1rem;
      }

      .fut {
        margin-top: 20px;
        color: #148614;
      }

      @media screen and (max-width: 600px) {
        .container {
          width: 300px;
          height: 300px;
          grid-template-columns: repeat(3, 100px);
          grid-template-rows: repeat(5, 60px);
        }

        .title {
          font-size: 4rem;
          color: orange;
        }

        .veleb {
          display: none;
        }

        .box {
          width: 100px;
          height: 60px;
          font-size: 0.8rem;
        }
      }

      @media screen and (max-width: 488px) {
        .container {
          width: 200px;
          height: 400px;
          grid-template-columns: repeat(2, 100px);
          grid-template-rows: repeat(8, 50px);
        }

        .title {
          font-size: 3rem;
        }

        .box {
          width: 100px;
          height: 50px;
          font-size: 0.7rem;
        }

        .modal-content {
          padding: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- Overlay for clicking outside modal - COVERS REST OF PAGE -->
    <div class="modal-overlay" id="modalOverlay" onclick="closeModal()"></div>

    <div class="c" id="top">
      <main class="container" x-data="app()">
        <!-- Content boxes - start blue, reveal to green -->
        <template x-for="(box, index) in contentBoxes" :key="index">
          <div
            class="box"
            :class="{ 'green': box.revealed }"
            @click="openModal(box)"
            x-init="setTimeout(() => { box.revealed = true }, index * 100 + 300)"
          >
            <span x-text="box.title" x-show="box.revealed"></span>
          </div>
        </template>

        <!-- Transparent boxes - start blue, reveal to transparent -->
        <template x-for="(box, index) in transparentBoxes" :key="index">
          <div
            class="box"
            :class="{ 'trans': box.revealed }"
            x-init="setTimeout(() => { box.revealed = true }, (index + contentBoxes.length) * 100 + 300)"
          ></div>
        </template>

        <!-- Velebit image and title -->
        <div class="veleb">
          <img src="velebit_z.jpg" alt="Velebit" />
        </div>
        <h1 class="title">Ekomuzej</h1>

        <!-- Modal - COVERS CONTAINER -->
        <div id="pjatModal" class="modal">
          <div class="modal-content">
            <button class="close-modal" onclick="closeModal()">×</button>
            <div id="modalContent"></div>
          </div>
        </div>
      </main>
    </div>

    <footer class="fut">
      <!-- cookies & copyright -->
    </footer>

    <script>
      // Simple modal functions
      function openModal(content) {
        const modal = document.getElementById("pjatModal");
        const overlay = document.getElementById("modalOverlay");
        const contentDiv = document.getElementById("modalContent");

        contentDiv.innerHTML = content;
        modal.classList.add("active");
        overlay.classList.add("active");
      }

      function closeModal() {
        const modal = document.getElementById("pjatModal");
        const overlay = document.getElementById("modalOverlay");
        modal.classList.remove("active");
        overlay.classList.remove("active");
      }

      // Close modal with Escape key
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") {
          closeModal();
        }
      });

      function app() {
        return {
          //prettier-ignore
          contentBoxes: [
            { title: "o ekomuzeju", pjat: "o_ekomuzeju", revealed: false },
            { title: "mobilne aplikacije", pjat: "mobilne_app", revealed: false },
            { title: "X/twitter", pjat: "default", revealed: false },
            { title: "facebook", pjat: "default", revealed: false },
            { title: "instagram", pjat: "default", revealed: false },
            { title: "o nama", pjat: "onama", revealed: false },
            { title: "DEMO", pjat: "demo", revealed: false },
            { title: "ponuda", pjat: "ponuda", revealed: false },
            { title: "reference", pjat: "reference", revealed: false },
            { title: "kontakt", pjat: "kontakt", revealed: false },
          ],
          transparentBoxes: Array(15)
            .fill()
            .map(() => ({ revealed: false })),

          openModal(box) {
            if (!box.revealed) return;

            console.log("Opening modal for:", box.title);

            const content = this.getPjatContent(box);
            openModal(content);
          },

          getPjatContent(box) {
            const contents = {
              o_ekomuzeju: `
                <div class="pjat">
                  <h2>o ekomuzeju</h2>
                  <p>ekomuzej je model interpretacije baštine - prirodne, kao i materijalne i nematerijalne kulturna baština</p>
                  <p>Osnovne karakteristike ekomuzeja su:</p>
                  <ul>
                    <li>pokrivaju područje koje se pruža izvan zidova;</li>
                    <li>fragmentirana lokacija i interpretacija na licu mjesta;</li>
                    <li>suradnja i partnerstvo, umjesto vlasništva nad izložbama ili kolekcijama;</li>
                    <li>uključenost lokalne zajednice u aktivnosti muzeja;</li>
                    <li>holistička, interdisciplinarna interpretacija.</li>
                  </ul>
                </div>
              `,
              mobilne_app: `
                <div class="pjat">
                  <h2>mobilne aplikacije</h2>
                  <p>U današnjem svijetu, mobilne aplikacije su sveprisutne, a u kontekstu ekomuzeja mogu imati značajnu ulogu, kako u navigaciji posjetitelja, tako i u interpretaciji muzejske građe.</p>
                  <p>Naše mobilne aplikacije izrađene su u <i>state-of-the art</i> tehnologijama, koje posjetiocima pružaju užitak korištenja, kako u <i>online</i>, tako i u <i>offline</i> režimu rada.</p>
                </div>
              `,
              onama: `
                <div class="pjat">
                  <h2>O nama</h2>
                  <p>Mjesto i vrijeme</p>
                  <p>Plavi peristil</p>
                </div>
              `,
              demo: `
                <div class="pjat">
                  <h2>[DEMO] Zagrebački spomenici</h2>
                  <p>Ovdje možete besplatno preuzeti edukativnu igru <strong>Zagrebački spomenici</strong>, koja ilustrira jedan od mogućih scenarija korištenja mobilne aplikacije u oblikovanju ekomuzeja.</p>
                  <p>Demo aplikacija je dostupna za <i>Android</i> platformu.</p>
                  <div class="dlogici">
                    <a href="jesiJEA.apk" download="demo.apk">
                      <img src="icon/Android_logo.png" width="140" alt="Android_logo">
                    </a>
                  </div>
                </div>
              `,
              ponuda: `
                <div class="pjat">
                  <h2>ponuda</h2>
                <p>digitalizacija sadržaja</p>
                <p>web applikacije</p>
                <p>mobilne aplikacije</p>
                 </div>
              `,
              reference: `
                <div class="pjat">
                  <h2>reference</h2>
                <p>općina Moščenička draga</p>
                </div>
              `,

              kontakt: `
                <div class="pjat">
                  <h2>kontakt</h2>
                  <p>Plavi peristil d.o.o.</p>
                  <p>Tratinska 80a</p>
                  <p>10 000 Zagreb</p>
                  <p>ekomuzej11@gmail.com</p>
                </div>
              `,

              default: `
                <div class="pjat">
                  <h2>${box.title}</h2>
                  <p>Gallia est omnis divisa in partes tres</p>
                </div>
              `,
            };

            return contents[box.pjat] || contents.default;
          },
        };
      }
    </script>
  </body>
</html>
